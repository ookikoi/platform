# Environment Variables Template
# Copy to .env and fill in values for local development

# AWS Configuration
AWS_PROFILE=company-platform
AWS_REGION=eu-west-1

# DynamoDB (local development)
DYNAMODB_ENDPOINT=http://localhost:8000

# Tables
MEMBERS_TABLE=members-dev
REVIEWS_TABLE=reviews-dev
PRODUCTS_TABLE=products-dev

# Event Bus
EVENT_BUS_NAME=platform-events-dev

# Node
NODE_ENV=development
NODE_OPTIONS=--enable-source-maps

# Logging
DEBUG=false
LOG_LEVEL=info

# Feature Flags
FEATURE_FLAG_REVIEWS_V2=false
FEATURE_FLAG_NEW_SEARCH=false

# External APIs (for local testing)
STRIPE_API_KEY=sk_test_local_key
SENDGRID_API_KEY=SG.test_key

# To use: source .env
